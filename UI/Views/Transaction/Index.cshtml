@model UI.Models.TransactionIndexViewModel
@{
    ViewData["Title"] = "İşlemlerim";
    Layout = ViewBag.Layout ?? "_LayoutUser";
}

<div class="container-fluid">
    
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni İşlem
                    </a>
                </div>
                <h4 class="page-title">İşlemlerim</h4>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-stats-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-0">@Model.CurrentBalance.ToString("C")</h3>
                            <p class="text-muted mb-0">Mevcut Bakiye</p>
                        </div>
                        <div class="text-end">
                            <i class="fas fa-wallet fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card dashboard-card">
                <div class="card-header">
                    <h4 class="card-title">Tüm İşlemlerim</h4>
                </div>
                <div class="card-body">
                    @if (Model.Transactions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-centered table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Tür</th>
                                        <th>Kategori</th>
                                        <th>Açıklama</th>
                                        <th>Tutar</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model.Transactions)
                                    {
                                        <tr class="dashboard-transaction-item">
                                            <td>@transaction.TransactionDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                @if (transaction.Type == Entity.TransactionType.Income)
                                                {
                                                    <span class="badge bg-success">Gelir</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Gider</span>
                                                }
                                            </td>
                                            <td>@transaction.Category</td>
                                            <td>@transaction.Description</td>
                                            <td>
                                                <span class="@(transaction.Type == Entity.TransactionType.Income ? "text-success" : "text-danger")">
                                                    @(transaction.Type == Entity.TransactionType.Income ? "+" : "-")@transaction.Amount.ToString("C")
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@transaction.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@transaction.Id" method="post" style="display: inline;">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            onclick="return confirm('Bu işlemi silmek istediğinizden emin misiniz?')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Henüz işlem bulunmuyor</h5>
                            <p class="text-muted">İlk işleminizi eklemek için "Yeni İşlem" butonuna tıklayın.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus"></i> İlk İşlemi Ekle
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
