@model IEnumerable<Entity.DTO.User.UserResponseDto>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var total = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var search = (string)ViewBag.Search;
    var role = (string)ViewBag.Role;
    bool? isBanned = (bool?)ViewBag.IsBanned;
    var sortBy = (string)(ViewBag.SortBy ?? "id");
    bool sortDesc = (bool)(ViewBag.SortDesc ?? false);
    int totalPages = (int)Math.Ceiling(total / (double)pageSize);
}

<h2 class="mb-3">Kullanıcı Yönetimi</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" type="text" name="search" value="@search" placeholder="Ad, soyad veya e-posta ara" />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="role">
            <option value="">Tüm Roller</option>
            <option value="Admin" selected="@(role=="Admin" ? "selected" : null)">Admin</option>
            <option value="User" selected="@(role=="User" ? "selected" : null)">User</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="isBanned">
            <option value="" selected="@((isBanned==null)?"selected":null)">Ban Durumu (Hepsi)</option>
            <option value="true" selected="@((isBanned==true)?"selected":null)">Banlı</option>
            <option value="false" selected="@((isBanned==false)?"selected":null)">Aktif</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="sortBy">
            <option value="id" selected="@((sortBy=="id")?"selected":null)">Id</option>
            <option value="firstname" selected="@((sortBy=="firstname")?"selected":null)">Ad</option>
            <option value="lastname" selected="@((sortBy=="lastname")?"selected":null)">Soyad</option>
            <option value="email" selected="@((sortBy=="email")?"selected":null)">E-posta</option>
            <option value="role" selected="@((sortBy=="role")?"selected":null)">Rol</option>
            <option value="isbanned" selected="@((sortBy=="isbanned")?"selected":null)">Ban</option>
        </select>
    </div>
    <div class="col-md-1 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="sortDesc" value="true" @(sortDesc?"checked":null) id="sortDescChk" />
            <label class="form-check-label" for="sortDescChk">Azalan</label>
        </div>
    </div>
    <div class="col-md-1">
        <button class="btn btn-primary w-100" type="submit">Uygula</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Ad Soyad</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Durum</th>
                <th style="width:260px"></th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null)
        {
            foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@u.Id">@u.UserName</a>
                    </td>
                    <td>@u.Email</td>
                    <td>@u.Role</td>
                    <td>@(u.IsBanned ? "Banlı" : "Aktif")</td>
                    <td>
                        <form asp-action="Ban" asp-controller="Admin" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="btn btn-sm btn-warning" @(u.IsBanned ? "disabled" : null)>Banla</button>
                        </form>
                        <form asp-action="Unban" asp-controller="Admin" method="post" class="d-inline ms-1">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="btn btn-sm btn-success" @(!u.IsBanned ? "disabled" : null)>Ban Kaldır</button>
                        </form>
                        <form asp-action="Delete" asp-controller="Admin" method="post" class="d-inline ms-1" onsubmit="return confirm('Silinsin mi?');">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                var active = i == page ? "active" : null;
                <li class="page-item @active">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@search"
                       asp-route-role="@role"
                       asp-route-isBanned="@isBanned"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortDesc="@sortDesc"
                       asp-route-page="@i"
                       asp-route-pageSize="@pageSize">@i</a>
                </li>
            }
        </ul>
    </nav>
}
