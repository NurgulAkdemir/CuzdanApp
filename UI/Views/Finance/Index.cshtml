@{
    ViewData["Title"] = "Bireysel Finans";
}

<div class="finance-hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <div class="finance-content">
                    <h1 class="finance-title">Bireysel Finans Yönetimi</h1>
                    <p class="finance-subtitle">Kişisel finansal hedeflerinize ulaşmak için profesyonel araçlar ve rehberlik</p>
                    <div class="finance-features">
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Bütçe planlama ve takip</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Yatırım stratejileri</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Borç yönetimi</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="finance-visual">
                    <div class="finance-chart-container">
                        <div class="chart-circle">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <div class="chart-data">
                            <div class="data-point income">
                                <span class="data-label">Gelir</span>
                                <span class="data-value">₺15,000</span>
                            </div>
                            <div class="data-point expense">
                                <span class="data-label">Gider</span>
                                <span class="data-value">₺8,500</span>
                            </div>
                            <div class="data-point savings">
                                <span class="data-label">Tasarruf</span>
                                <span class="data-value">₺6,500</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="finance-tools-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2>Finansal Araçlarımız</h2>
            <p class="lead">Kişisel finansal durumunuzu analiz etmek ve iyileştirmek için güçlü araçlar</p>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <div class="tool-card">
                    <div class="tool-icon">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <h4>Bütçe Hesaplayıcı</h4>
                    <p>Aylık gelir ve giderlerinizi analiz edin, bütçe hedeflerinizi belirleyin ve tasarruf oranınızı hesaplayın.</p>
                    <div class="tool-features">
                        <span class="tool-feature">Gelir analizi</span>
                        <span class="tool-feature">Gider kategorileri</span>
                        <span class="tool-feature">Tasarruf hedefleri</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="tool-card">
                    <div class="tool-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h4>Yatırım Analizi</h4>
                    <p>Farklı yatırım seçeneklerini karşılaştırın, risk analizi yapın ve uzun vadeli finansal planınızı oluşturun.</p>
                    <div class="tool-features">
                        <span class="tool-feature">Risk değerlendirmesi</span>
                        <span class="tool-feature">Getiri hesaplama</span>
                        <span class="tool-feature">Portföy çeşitlendirme</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="tool-card">
                    <div class="tool-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <h4>Borç Yönetimi</h4>
                    <p>Kredi kartı borçlarınızı, kredilerinizi ve taksit ödemelerinizi organize edin ve borç stratejinizi planlayın.</p>
                    <div class="tool-features">
                        <span class="tool-feature">Borç konsolidasyonu</span>
                        <span class="tool-feature">Ödeme planları</span>
                        <span class="tool-feature">Faiz hesaplama</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="finance-education-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="education-content">
                    <h2>Finansal Okuryazarlık</h2>
                    <p class="lead">Finansal kararlarınızı daha bilinçli almak için eğitim materyalleri ve rehberlik</p>
                    <div class="education-topics">
                        <div class="topic-item">
                            <i class="fas fa-graduation-cap"></i>
                            <div>
                                <h5>Temel Finans</h5>
                                <p>Gelir, gider, tasarruf ve yatırım kavramları</p>
                            </div>
                        </div>
                        <div class="topic-item">
                            <i class="fas fa-book"></i>
                            <div>
                                <h5>Yatırım Stratejileri</h5>
                                <p>Risk yönetimi ve portföy çeşitlendirme</p>
                            </div>
                        </div>
                        <div class="topic-item">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <h5>Finansal Güvenlik</h5>
                                <p>Dijital güvenlik ve dolandırıcılık koruması</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="education-visual">
                    <div class="progress-container">
                        <div class="progress-item">
                            <div class="progress-label">Finansal Hedefler</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 75%"></div>
                            </div>
                            <div class="progress-value">75%</div>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">Tasarruf Oranı</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 60%"></div>
                            </div>
                            <div class="progress-value">60%</div>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">Yatırım Bilgisi</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 45%"></div>
                            </div>
                            <div class="progress-value">45%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="finance-cta-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2>Finansal Geleceğinizi Bugün Planlayın</h2>
                <p class="lead">Ücretsiz hesap oluşturun ve kişisel finansal yönetiminizi başlatın</p>
                <div class="cta-buttons">
                    <a href="/User/Register" class="btn btn-primary btn-lg me-3">
                        <i class="fas fa-rocket"></i> Hemen Başla
                    </a>
                    <a href="/Home/About" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-info-circle"></i> Daha Fazla Bilgi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
