@{
    ViewData["Title"] = "Finansal Analiz";
    Layout = "_Layout";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="page-header text-center mb-5">
                <h1 class="display-4 text-primary">
                    <i class="fas fa-chart-line me-3"></i>Finansal Analiz
                </h1>
                <p class="lead text-muted">Finansal durumunuzu analiz edin ve geleceğinizi planlayın</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-calculator fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Taksit Hesaplama</h5>
                    <p class="card-text text-muted">Kredi ve taksit ödemelerinizi hesaplayın, en uygun seçenekleri bulun.</p>
                    <a href="#" class="btn btn-primary">
                        <i class="fas fa-calculator me-2"></i>Hesapla
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-chart-pie fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Gelir-Gider Analizi</h5>
                    <p class="card-text text-muted">Gelir ve giderlerinizi kategorilere göre analiz edin, tasarruf fırsatlarını keşfedin.</p>
                    <a href="#" class="btn btn-success">
                        <i class="fas fa-chart-pie me-2"></i>Analiz Et
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-piggy-bank fa-3x text-warning"></i>
                    </div>
                    <h5 class="card-title">Tasarruf Planı</h5>
                    <p class="card-text text-muted">Hedeflerinize ulaşmak için kişiselleştirilmiş tasarruf planları oluşturun.</p>
                    <a href="#" class="btn btn-warning text-white">
                        <i class="fas fa-piggy-bank me-2"></i>Plan Oluştur
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Finansal İpuçları
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Bütçe Yapın:</strong> Aylık gelir ve giderlerinizi takip edin
                        </li>
                        <li class="mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Acil Durum Fonu:</strong> En az 3 aylık giderinizi karşılayacak tasarruf yapın
                        </li>
                        <li class="mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Yatırım Çeşitlendirin:</strong> Riskleri dağıtmak için farklı yatırım araçları kullanın
                        </li>
                        <li class="mb-3">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Borç Yönetimi:</strong> Yüksek faizli borçları öncelikli olarak ödeyin
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-target me-2"></i>Finansal Hedefler
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Kısa Vadeli (1-3 yıl)</h6>
                        <ul class="list-unstyled text-muted">
                            <li><i class="fas fa-arrow-right me-2"></i>Acil durum fonu oluşturma</li>
                            <li><i class="fas fa-arrow-right me-2"></i>Küçük borçları ödeme</li>
                            <li><i class="fas fa-arrow-right me-2"></i>Yıllık tatil planı</li>
                        </ul>
                    </div>
                    <div class="mb-3">
                        <h6>Orta Vadeli (3-10 yıl)</h6>
                        <ul class="list-unstyled text-muted">
                            <li><i class="fas fa-arrow-right me-2"></i>Ev alımı için birikim</li>
                            <li><i class="fas fa-arrow-right me-2"></i>Çocuk eğitimi fonu</li>
                            <li><i class="fas fa-arrow-right me-2"></i>İş kurma sermayesi</li>
                        </ul>
                    </div>
                    <div>
                        <h6>Uzun Vadeli (10+ yıl)</h6>
                        <ul class="list-unstyled text-muted">
                            <li><i class="fas fa-arrow-right me-2"></i>Emeklilik planı</li>
                            <li><i class="fas fa-arrow-right me-2"></i>Miras planlaması</li>
                            <li><i class="fas fa-arrow-right me-2"></i>Varlık transferi</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Finansal Sağlık Kontrolü
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary">Güçlü Yönler</h6>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-plus-circle text-success me-2"></i>Düzenli gelir</li>
                                <li><i class="fas fa-plus-circle text-success me-2"></i>Düşük borç oranı</li>
                                <li><i class="fas fa-plus-circle text-success me-2"></i>Diversifikasyon</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-danger">Geliştirilecek Alanlar</h6>
                            <ul class="list-unstyled text-muted">
                                <li><i class="fas fa-minus-circle text-warning me-2"></i>Acil durum fonu</li>
                                <li><i class="fas fa-minus-circle text-warning me-2"></i>Yatırım çeşitliliği</li>
                                <li><i class="fas fa-minus-circle text-warning me-2"></i>Sigorta kapsamı</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
