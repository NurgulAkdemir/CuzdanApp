<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            width: 280px;
            background: #2c3e50;
            color: white;
            z-index: 1000;
        }

        .main-content {
            margin-left: 280px;
            padding: 20px;
        }

        .nav-link {
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            display: block;
        }

        .nav-link:hover {
            background: #34495e;
            color: white;
        }

        .nav-link.active {
            background: #8e44ad;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div style="padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.1);">
            <h4><i class="fas fa-wallet"></i> Walletly</h4>
        </div>
        
        <nav style="padding: 20px 0;">
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link active">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            
            <a asp-controller="Transaction" asp-action="Index" class="nav-link">
                <i class="fas fa-exchange-alt"></i> İşlemler
            </a>
            
            <a asp-controller="Installment" asp-action="Index" class="nav-link">
                <i class="fas fa-calendar-check"></i> Taksitler
            </a>
            
            <a asp-controller="Balance" asp-action="Index" class="nav-link">
                <i class="fas fa-coins"></i> Bakiye
            </a>
            
            <a asp-controller="Report" asp-action="Index" class="nav-link">
                <i class="fas fa-chart-line"></i> Raporlar
            </a>
            
            <hr style="border-color: rgba(255,255,255,0.1);">
            
            <a asp-controller="User" asp-action="Profile" class="nav-link">
                <i class="fas fa-user-circle"></i> Profil
            </a>
            
            <a asp-controller="User" asp-action="Logout" class="nav-link">
                <i class="fas fa-sign-out-alt"></i> Çıkış
            </a>
        </nav>
    </div>

    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
