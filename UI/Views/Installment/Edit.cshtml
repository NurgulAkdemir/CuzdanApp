@model Entity.DTO.Installment.InstallmentUpdateDto
@{
    ViewData["Title"] = "Taksit Düzenle";
    Layout = ViewBag.Layout ?? "_LayoutUser";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Geri Dön
                    </a>
                </div>
                <h4 class="page-title">Taksit Düzenle</h4>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="OriginalAmount" class="form-label">Anapara Tutarı *</label>
                                    <div class="input-group">
                                        <input asp-for="OriginalAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <span asp-validation-for="OriginalAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TotalAmount" class="form-label">Toplam Tutar *</label>
                                    <div class="input-group">
                                        <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InterestRate" class="form-label">Faiz Oranı (%) *</label>
                                    <div class="input-group">
                                        <input asp-for="InterestRate" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0.00" required />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="InterestRate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InterestType" class="form-label">Faiz Türü *</label>
                                    <select asp-for="InterestType" class="form-select" required>
                                        <option value="1">Yıllık</option>
                                        <option value="2">Aylık</option>
                                    </select>
                                    <span asp-validation-for="InterestType" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TotalInstallments" class="form-label">Toplam Taksit Sayısı *</label>
                                    <input asp-for="TotalInstallments" type="number" min="1" max="120" class="form-control" placeholder="12" required />
                                    <span asp-validation-for="TotalInstallments" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InstallmentCount" class="form-label">Kalan Taksit Sayısı *</label>
                                    <input asp-for="InstallmentCount" type="number" min="0" class="form-control" placeholder="0" required />
                                    <span asp-validation-for="InstallmentCount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="MonthlyAmount" class="form-label">Aylık Taksit Tutarı *</label>
                                    <div class="input-group">
                                        <input asp-for="MonthlyAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                    <span asp-validation-for="MonthlyAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="StartDate" class="form-label">Başlangıç Tarihi *</label>
                                    <input asp-for="StartDate" type="date" class="form-control" required />
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="NextPaymentDate" class="form-label">Sonraki Ödeme Tarihi</label>
                                    <input asp-for="NextPaymentDate" type="date" class="form-control" />
                                    <span asp-validation-for="NextPaymentDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IsActive" class="form-label">Aktif Durum</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" for="IsActive">Taksit aktif</label>
                                    </div>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Taksit Açıklaması *</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Taksit hakkında açıklama..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="text-end">
                            <a asp-action="Index" class="btn btn-secondary me-2">İptal</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation için gerekli script'ler buraya eklenebilir
    </script>
}
