@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-section">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show position-absolute top-0 start-50 translate-middle-x mt-3" role="alert" style="z-index: 1000;">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row align-items-center min-vh-100 mx-0">
        <div class="col-lg-6 px-5">
            <div class="hero-content">
                <h1 class="hero-title">Walletly ile Finansal Özgürlüğünüzü Keşfedin</h1>
                <p class="hero-subtitle">Gelir ve giderlerinizi akıllıca yönetin, taksit planlarınızı organize edin ve bakiye durumunuzu gerçek zamanlı takip edin.</p>
                
                <div class="hero-buttons">
                    <a asp-controller="User" asp-action="Register" class="btn btn-primary btn-lg me-3">
                        <i class="fas fa-user-plus"></i> Hemen Başla
                    </a>
                    <a asp-controller="User" asp-action="Login" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-sign-in-alt"></i> Giriş Yap
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-6 px-5">
            <div class="hero-visual">
                <div class="floating-card card-1">
                    <i class="fas fa-wallet"></i>
                    <span>Bakiye Takibi</span>
                </div>
                <div class="floating-card card-2">
                    <i class="fas fa-chart-pie"></i>
                    <span>Grafik Analiz</span>
                </div>
                <div class="floating-card card-3">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Taksit Planı</span>
                </div>
                <div class="floating-card card-4">
                    <i class="fas fa-exchange-alt"></i>
                    <span>İşlem Geçmişi</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cta-section py-5">
    <div class="row justify-content-center mx-0">
        <div class="col-md-8 text-center px-5">
            <h2>Finansal Yönetiminizi Bugün Başlatın</h2>
            <p class="lead">Ücretsiz hesap oluşturun ve finansal hedeflerinize ulaşın</p>
            <div class="cta-buttons">
                <a asp-controller="User" asp-action="Register" class="btn btn-primary btn-lg me-3">
                    <i class="fas fa-rocket"></i> Ücretsiz Başla
                </a>
                <a asp-controller="User" asp-action="Login" class="btn btn-outline-light btn-lg">
                    <i class="fas fa-sign-in-alt"></i> Zaten Hesabım Var
                </a>
            </div>
        </div>
    </div>
</div>

<div id="features" class="features-overview py-5">
    <div class="row mx-0">
        <div class="col-lg-4 px-4">
            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h4>Güvenli</h4>
                <p>Verileriniz şifrelenmiş olarak saklanır ve sadece siz erişebilirsiniz.</p>
            </div>
        </div>
        <div class="col-lg-4 px-4">
            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h4>Mobil Uyumlu</h4>
                <p>Tüm cihazlarda mükemmel çalışır, her yerden erişim sağlar.</p>
            </div>
        </div>
        <div class="col-lg-4 px-4">
            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h4>Analitik</h4>
                <p>Detaylı raporlar ve grafiklerle finansal durumunuzu analiz edin.</p>
            </div>
        </div>
    </div>
</div>
