@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center">
    <h1 class="display-4">CuzdanApp'e Hoş Geldiniz</h1>
    <p class="lead">Finansal durumunuzu takip etmek ve yönetmek için güçlü araçlar.</p>
    <hr class="my-4">
    <p>Gelir ve giderlerinizi kaydedin, taksit planlarınızı oluşturun ve bakiye durumunuzu takip edin.</p>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">İşlemler</h5>
                        <p class="card-text">Gelir ve gider kayıtlarınızı yönetin</p>
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-light">Görüntüle</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Taksitler</h5>
                        <p class="card-text">Taksit planlarınızı oluşturun ve takip edin</p>
                        <a asp-controller="Installment" asp-action="Index" class="btn btn-light">Görüntüle</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Bakiye</h5>
                        <p class="card-text">Güncel bakiye durumunuzu kontrol edin</p>
                        <a asp-controller="Balance" asp-action="Index" class="btn btn-light">Görüntüle</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Profil</h5>
                        <p class="card-text">Hesap bilgilerinizi güncelleyin</p>
                        <a asp-controller="User" asp-action="Profile" class="btn btn-light">Görüntüle</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Zaten hesabınız var mı?</h5>
                        <p class="card-text">Giriş yaparak finansal durumunuzu takip etmeye başlayın.</p>
                        <a asp-controller="User" asp-action="Login" class="btn btn-primary">Giriş Yap</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Yeni misiniz?</h5>
                        <p class="card-text">Hemen kayıt olun ve finansal yönetiminizi başlatın.</p>
                        <a asp-controller="User" asp-action="Register" class="btn btn-success">Kayıt Ol</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
