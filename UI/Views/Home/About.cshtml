@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="about-hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <div class="about-content">
                    <h1 class="about-title">Walletly Hakkında</h1>
                    <p class="about-subtitle">Finansal özgürlüğünüz için güvenilir çözüm ortağınız</p>
                    <div class="about-stats">
                        <div class="stat-item">
                            <div class="stat-number">10K+</div>
                            <div class="stat-label">Aktif Kullanıcı</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">5+</div>
                            <div class="stat-label">Yıllık Deneyim</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">99.9%</div>
                            <div class="stat-label">Güvenilirlik</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-visual">
                    <div class="about-image-container">
                        <div class="about-image">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="floating-element element-1">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="floating-element element-2">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="floating-element element-3">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="about-mission-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h4>Misyonumuz</h4>
                    <p>Kullanıcılarımızın finansal hedeflerine ulaşmasına yardımcı olmak ve para yönetimini kolaylaştırmak için yenilikçi teknolojiler geliştirmek.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h4>Vizyonumuz</h4>
                    <p>Finansal teknoloji alanında lider olmak ve herkesin finansal okuryazarlığını artırarak daha iyi bir gelecek inşa etmek.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h4>Değerlerimiz</h4>
                    <p>Güven, şeffaflık, yenilikçilik ve müşteri memnuniyeti. Her kararımızda bu değerleri ön planda tutuyoruz.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="about-team-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2>Ekibimiz</h2>
            <p class="lead">Finansal teknoloji alanında uzman ekibimizle hizmetinizdeyiz</p>
        </div>
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <div class="member-avatar">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <h5>Ahmet Yılmaz</h5>
                    <p class="member-role">Kurucu & CEO</p>
                    <p class="member-desc">10+ yıl fintech deneyimi</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <div class="member-avatar">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h5>Ayşe Demir</h5>
                    <p class="member-role">CTO</p>
                    <p class="member-desc">Yazılım geliştirme uzmanı</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <div class="member-avatar">
                        <i class="fas fa-user-chart"></i>
                    </div>
                    <h5>Mehmet Kaya</h5>
                    <p class="member-role">Finans Direktörü</p>
                    <p class="member-desc">Risk yönetimi uzmanı</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <div class="member-avatar">
                        <i class="fas fa-user-cog"></i>
                    </div>
                    <h5>Fatma Öz</h5>
                    <p class="member-role">Ürün Müdürü</p>
                    <p class="member-desc">Kullanıcı deneyimi uzmanı</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="about-contact-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2>Bizimle İletişime Geçin</h2>
                <p class="lead">Sorularınız için bize ulaşın</p>
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fas fa-envelope"></i>
                        <span>info@cuzdanapp.com</span>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-phone"></i>
                        <span>+90 212 555 0123</span>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Ankara, Türkiye</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
