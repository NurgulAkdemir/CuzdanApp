@model UI.Models.TransactionReportViewModel
@{
    ViewData["Title"] = "Raporlar";
    Layout = "_LayoutApp";
}

<div class="container-fluid">
    <!-- Sayfa Başlığı -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-welcome fade-in">
                <h4 class="mb-0">
                    <i class="fas fa-chart-line me-2"></i>
                    İşlem Raporları
                </h4>
                <p class="mb-0 mt-2">Tarih aralığı ve işlem türüne göre detaylı raporlar görüntüleyin.</p>
            </div>
        </div>
    </div>

    <!-- Filtre Formu -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card slide-in-left" style="animation-delay: 0.1s;">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-filter me-2"></i>
                        Rapor Filtreleri
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="GetReport" method="post" class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="SelectedType" class="form-label"></label>
                            <select asp-for="SelectedType" class="form-select">
                                @foreach (var option in Model.TransactionTypeOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            <span asp-validation-for="SelectedType" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Rapor Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Summary != null)
    {
        <!-- Özet Kartları -->
        <div class="row mb-4">
            <!-- İlk Satır -->
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.2s;">
                    <div class="card-icon text-primary">
                        <i class="fas fa-list"></i>
                    </div>
                    <div class="card-value text-primary">@Model.Summary.TotalTransactionCount</div>
                    <div class="card-label">Toplam İşlem</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.3s;">
                    <div class="card-icon text-info">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                    <div class="card-value text-info">@Model.Summary.TotalIncomeAmount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                    <div class="card-label">Toplam Gelir</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.4s;">
                    <div class="card-icon text-danger">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div class="card-value text-danger">@Model.Summary.TotalExpenseAmount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                    <div class="card-label">Toplam Gider</div>
                </div>
            </div>
        </div>
        
        <div class="row mb-4">
            <!-- İkinci Satır -->
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.5s;">
                    <div class="card-icon text-warning">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="card-value text-warning">@Model.Summary.TotalInstallmentCount</div>
                    <div class="card-label">Toplam Taksit</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.6s;">
                    <div class="card-icon text-secondary">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="card-value text-secondary">@Model.Summary.TotalRemainingInstallmentAmount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                    <div class="card-label">Kalan Taksit</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="dashboard-stats-card slide-in-left" style="animation-delay: 0.7s;">
                    <div class="card-icon text-success">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <div class="card-value text-success">@Model.Summary.TotalAmount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                    <div class="card-label">Net Tutar</div>
                </div>
            </div>
        </div>

        <!-- Filtre Bilgileri -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card slide-in-left" style="animation-delay: 0.6s;">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            Filtre Bilgileri
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <strong>Tarih Aralığı:</strong><br>
                                @if (Model.Summary.StartDate.HasValue && Model.Summary.EndDate.HasValue)
                                {
                                    <span>@Model.Summary.StartDate.Value.ToString("dd.MM.yyyy") - @Model.Summary.EndDate.Value.ToString("dd.MM.yyyy")</span>
                                }
                                else if (Model.Summary.StartDate.HasValue)
                                {
                                    <span>@Model.Summary.StartDate.Value.ToString("dd.MM.yyyy") ve sonrası</span>
                                }
                                else if (Model.Summary.EndDate.HasValue)
                                {
                                    <span>@Model.Summary.EndDate.Value.ToString("dd.MM.yyyy") ve öncesi</span>
                                }
                                else
                                {
                                    <span>Tüm tarihler</span>
                                }
                            </div>
                            <div class="col-md-4">
                                <strong>İşlem Türü:</strong><br>
                                <span>@Model.Summary.FilteredTypeDisplayName</span>
                            </div>
                            <div class="col-md-4">
                                <strong>Gelir/Gider/Taksit Dağılımı:</strong><br>
                                <span class="text-success">@Model.Summary.IncomeTransactionCount Gelir</span> | 
                                <span class="text-danger">@Model.Summary.ExpenseTransactionCount Gider</span> |
                                <span class="text-warning">@Model.Summary.TotalInstallmentCount Taksit</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- İşlemler Tablosu -->
        <div class="row">
            <div class="col-12">
                <div class="card slide-in-left" style="animation-delay: 0.7s;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-table me-2"></i>
                            İşlem Detayları (@Model.Transactions.Count adet)
                        </h5>
                        @if (Model.Transactions.Any())
                        {
                            <button class="btn btn-sm btn-outline-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel me-1"></i>Excel'e Aktar
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (Model.Transactions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover" id="transactionsTable">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Tarih</th>
                                            <th>Kategori</th>
                                            <th>Açıklama</th>
                                            <th>Tür</th>
                                            <th>Taksit Bilgisi</th>
                                            <th class="text-end">Tutar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaction in Model.Transactions)
                                        {
                                            <tr class="@(transaction.IsInstallment ? "table-warning" : "")">
                                                <td>@transaction.TransactionDate.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="badge @(transaction.IsInstallment ? "bg-warning" : "bg-secondary")">
                                                        @transaction.Category
                                                        @if (transaction.IsInstallment)
                                                        {
                                                            <i class="fas fa-calendar-check ms-1"></i>
                                                        }
                                                    </span>
                                                </td>
                                                <td>@transaction.Description</td>
                                                <td>
                                                    <span class="badge @(transaction.Type == Entity.TransactionType.Income ? "bg-success" : "bg-danger")">
                                                        @transaction.TypeDisplayName
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (transaction.IsInstallment && transaction.RemainingInstallments.HasValue)
                                                    {
                                                        <div class="small">
                                                            <div><strong>Kalan:</strong> @transaction.RemainingInstallments taksit</div>
                                                            <div><strong>Tutar:</strong> @transaction.RemainingAmount?.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <span class="@(transaction.Type == Entity.TransactionType.Income ? "text-success" : "text-danger") fw-bold">
                                                        @(transaction.Type == Entity.TransactionType.Income ? "+" : "-")@transaction.Amount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">Seçilen kriterlere uygun işlem bulunamadı</h5>
                                <p class="text-muted">Farklı tarih aralığı veya işlem türü deneyebilirsiniz.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Başlangıç Mesajı -->
        <div class="row">
            <div class="col-12">
                <div class="card slide-in-left" style="animation-delay: 0.2s;">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Rapor Oluşturmak İçin Filtreleri Seçin</h5>
                        <p class="text-muted">Tarih aralığı ve işlem türü seçerek detaylı raporlar oluşturabilirsiniz.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function exportToExcel() {
        // Basit Excel export fonksiyonu
        const table = document.getElementById('transactionsTable');
        const rows = Array.from(table.querySelectorAll('tr'));
        
        let csvContent = "data:text/csv;charset=utf-8,";
        
        rows.forEach(row => {
            const cells = Array.from(row.querySelectorAll('th, td'));
            const rowData = cells.map(cell => {
                // Badge'leri temizle
                const badge = cell.querySelector('.badge');
                if (badge) {
                    return badge.textContent.trim();
                }
                return cell.textContent.trim().replace(/,/g, ';');
            });
            csvContent += rowData.join(',') + '\n';
        });
        
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', 'islem_raporu.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
